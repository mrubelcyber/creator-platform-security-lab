# Copy to terraform.tfvars (gitignored) and fill in. Never commit real contact details.
security_contact = {
  name  = "<SECURITY_CONTACT_NAME>"
  title = "Security Engineer"
  email = "<SECURITY_CONTACT_EMAIL>"
  phone = "<+1-555-0100>"
}

# IAM.2: users that have IAMUserChangePassword attached directly (check with:
#   aws iam list-attached-user-policies --user-name <IAM_USER_NAME>)
# Phase 1 (adopt): list them. Phase 2 (retire): set to [] and apply again.
legacy_change_password_users = ["<IAM_USER_NAME>"]
